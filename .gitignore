
# =========================
# Python cache files
# =========================
__pycache__/
*.py[cod]
*$py.class

# =========================
# Virtual environments
# =========================
venv/
.venv/
env/
ENV/

# =========================
# Environment variables and secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Jupyter Notebook
# =========================
.ipynb_checkpoints/

# =========================
# IDE and operating system
# =========================
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# =========================
# Test and coverage files
# =========================
.pytest_cache/
.coverage
htmlcov/

# =========================
# Logs and temporary files
# =========================
*.log
*.tmp
tempCodeRunnerFile.py

# =========================
# Raw and processed datasets
# =========================
data/raw/*
data/processed/*

# Keep folders visible in Git
!data/raw/.gitkeep
!data/processed/.gitkeep

# =========================
# Generated model files
# =========================
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.pth
models/*.onnx
